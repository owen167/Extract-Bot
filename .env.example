DISCORD_TOKEN=your_discord_bot_token
DISCORD_PREFIX=!

# Primary detector: ogkalu RT-DETR comic text/bubble detector.
COMIC_MODEL_PATH=./models/comic-text-detector/detector-v4-s_int8.onnx
COMIC_CONFIDENCE=0.25

# Optional legacy Manga-Segment YOLO segmentation checkpoint.
MANGA_MODEL_PATH=./models/manga-segment/best.pt
SFX_MODEL_PATH=./models/manga-sfx-detector.pt
MANGA_IMAGE_SIZE=1280
MODEL_CONFIDENCE=0.35
SFX_CONFIDENCE=0.25

# Tesseract language packs: Korean + English + Japanese by default.
OCR_LANGUAGES=kor+eng+jpn
OCR_CONFIG=--oem 1 --psm 6
MIN_TEXT_LENGTH=1
READING_ORDER=top_to_bottom
MAX_ATTACHMENT_MB=100

# Optional JSON overrides for model labels, for example:
# MODEL_LABEL_MAP_JSON={"speech-balloon":"SPEECH","caption-box":"CAPTION","text":"SIDE_TEXT"}
MODEL_LABEL_MAP_JSON=
